{
  "name": "zaimviewer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy -c dist/zaimviewer/wrangler.json",
    "test": "vitest run",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p worker/tsconfig.scripts.json",
    "sync": "bun --env-file=.dev.vars run worker/scripts/sync.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "cf-typegen": "wrangler types",
    "db:init": "bun run worker/scripts/init-schema.ts > .schema.sql && wrangler d1 execute DB --remote --file .schema.sql -y"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@tanstack/react-query": "^5.101.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "jose": "^6.2.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "temporal-polyfill": "^1.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.2",
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/runner": "^4.1.0",
    "@vitest/snapshot": "^4.1.0",
    "daisyui": "^5.7.16",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  }
}
