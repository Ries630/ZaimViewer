{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zaimviewer",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zaimviewer",
      "database_id": "local-spike-placeholder"
    }
  ]
}
