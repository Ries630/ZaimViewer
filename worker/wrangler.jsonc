{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zaimviewer",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "observability": { "enabled": true },
  // ローカル開発では .dev.vars の ENVIRONMENT=development が上書きする。
  // POST /api/sync を本番で閉じるために使う（同期は scripts/sync.ts が正）
  "vars": { "ENVIRONMENT": "production" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zaim-viewer",
      "database_id": "153c167b-caf5-44b5-8037-99857f1d81d0",
    },
  ],
}
