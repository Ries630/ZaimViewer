# Zaim API の OAuth1.0a 認証情報
# https://dev.zaim.net/ でアプリ登録して取得する
ZAIM_CONSUMER_KEY=
ZAIM_CONSUMER_SECRET=
ZAIM_ACCESS_TOKEN=
ZAIM_ACCESS_TOKEN_SECRET=

# ローカル開発ではリポジトリルートの .dev.vars に置く（vite dev が自動で読む）。
# 本番へは wrangler secret put <NAME> で登録する。
# ただし同期を Worker の外へ出した（ADR-0015）ので、Zaim の認証情報を
# 本番に入れるのは編集プロキシ（工程③）を作るときで足りる。

# wrangler.jsonc の "production" を上書きし、POST /api/sync を開ける
ENVIRONMENT=development

# Cloudflare D1 の HTTP API（scripts/sync.ts が手元から書き込むのに使う）。
# トークンは Account > D1 > Edit 権限だけで足りる。
# D1_DATABASE_ID は wrangler.jsonc の database_id と同じ値。
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=

# Access の JWT 検証（src/access.ts）はローカルでは動かない。
# ENVIRONMENT=production のときだけ検証し、TEAM_DOMAIN / POLICY_AUD は
# 秘密でないので wrangler.jsonc の vars に置いてある（ADR-0019）
