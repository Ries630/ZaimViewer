# macOS
.DS_Store
._*

# 認証情報
.env
.dev.vars

# 依存とビルド成果物
node_modules/
# vite build の出力。dist/client が静的アセット、dist/zaimviewer が Worker。
# .dev.vars が複製されるので、絶対に追跡しない
dist/

# ログとテスト成果物
logs/
*.log
coverage/
*.lcov

# TypeScript / Vite
*.tsbuildinfo
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Worker
.wrangler/
worker-configuration.d.ts
# db:init が sync.ts の DDL から生成する。スキーマの正は sync.ts 側
.schema.sql

# Issue #37 の receipt_id 後付けで使う確認済み計画と処理済みログ
/.receipt-id-backfill-manifest.json
/.receipt-id-backfill-progress.jsonl

# ローカルの Codex 設定
/.codex/

# Playwright MCP の書き出し（スナップショットとコンソールログ）。
# スクリーンショットは既定でリポジトリ直下に落ちるので、
# 保存先も .playwright-mcp/ の下を指定する
.playwright-mcp/
